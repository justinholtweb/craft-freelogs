{
    "name": "justinholtweb/craft-freelog",
    "description": "View, search, filter, and download server logs from the Craft CMS control panel.",
    "type": "craft-plugin",
    "version": "5.0.4",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "logs",
        "server-logs",
        "debugging"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://github.com/justinholtweb"
        }
    ],
    "support": {
        "issues": "https://github.com/justinholtweb/craft-freelogs/issues",
        "source": "https://github.com/justinholtweb/craft-freelogs"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0"
    },
    "require-dev": {
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\freelog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\freelog\\tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "extra": {
        "name": "Freelog",
        "handle": "freelog",
        "hasCpSettings": false,
        "hasCpSection": true,
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-freelogs/main/CHANGELOG.md",
        "class": "justinholtweb\\freelog\\Plugin"
    }
}
