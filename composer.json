{
    "name": "justinholtweb/craft-freelog",
    "description": "View, search, filter, and download server logs from the Craft CMS control panel, with a redacted error digest by email.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "logs",
        "server-logs",
        "debugging",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://github.com/justinholtweb"
        }
    ],
    "support": {
        "issues": "https://github.com/justinholtweb/craft-freelogs/issues",
        "source": "https://github.com/justinholtweb/craft-freelogs"
    },
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Freelog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Freelog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Freelog",
        "handle": "freelog",
        "developer": "Justin Holt",
        "developerUrl": "https://github.com/justinholtweb",
        "documentationUrl": "https://github.com/justinholtweb/craft-freelogs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-freelogs/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Freelog\\Plugin"
    }
}
