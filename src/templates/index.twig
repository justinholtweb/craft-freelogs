{% extends '_layouts/cp.twig' %}

{% do view.registerAssetBundle('justinholtweb\\freelog\\assetbundles\\FreelogAsset') %}
{% do view.registerTranslations('freelog', [
    'Are you sure you want to clear this log file? This cannot be undone.',
]) %}

{% set title = 'Freelog'|t('freelog') %}

{% block content %}
    {% if files|length %}
        <div class="freelog-file-list">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ 'File'|t('freelog') }}</th>
                        <th scope="col">{{ 'Size'|t('freelog') }}</th>
                        <th scope="col">{{ 'Last modified'|t('freelog') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('freelog') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for file in files %}
                        <tr>
                            <td>
                                <a class="file-name" href="{{ cpUrl('freelog/view', { file: file.name }) }}">{{ file.name }}</a>
                                {% if file.compressed %}
                                    <span class="freelog-badge" title="{{ 'Gzip-compressed; decompressed on read'|t('freelog') }}">gz</span>
                                {% endif %}
                            </td>
                            <td class="freelog-file-meta">{{ file.sizeFormatted }}</td>
                            <td class="freelog-file-meta">{{ file.modifiedFormatted }}</td>
                            <td class="thin freelog-file-actions">
                                <div class="flex flex-nowrap">
                                    <a href="{{ cpUrl('freelog/view', { file: file.name }) }}" class="btn small">{{ 'View'|t('freelog') }}</a>
                                    <a href="{{ cpUrl('freelog/download', { file: file.name }) }}" class="btn small">{{ 'Download'|t('freelog') }}</a>
                                    {% if canClear %}
                                        <form method="post" class="freelog-clear-form">
                                            {{ csrfInput() }}
                                            {{ actionInput('freelog/logs/clear') }}
                                            {{ hiddenInput('file', file.name) }}
                                            <button type="submit" class="btn small secondary">{{ 'Clear'|t('freelog') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="freelog-empty">
            <p>{{ 'No log files found.'|t('freelog') }}</p>
        </div>
    {% endif %}
{% endblock %}
