{% extends '_layouts/cp.twig' %}

{% do view.registerAssetBundle('justinholtweb\\freelog\\assetbundles\\FreelogAsset') %}

{% set title = 'Freelog' %}

{% block content %}
    {% if files|length %}
        <div class="freelog-file-list">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Last Modified</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for file in files %}
                        <tr>
                            <td>
                                <a class="file-name" href="{{ cpUrl('freelog/view', { file: file.name }) }}">
                                    {{ file.name }}
                                </a>
                            </td>
                            <td class="freelog-file-meta">{{ file.sizeFormatted }}</td>
                            <td class="freelog-file-meta">{{ file.modifiedFormatted }}</td>
                            <td class="thin" style="white-space: nowrap;">
                                <div style="display: flex; gap: 4px;">
                                    <a href="{{ cpUrl('freelog/view', { file: file.name }) }}" class="btn small" title="View">View</a>
                                    <a href="{{ cpUrl('freelog/download', { file: file.name }) }}" class="btn small" title="Download">Download</a>
                                    <form method="post" class="freelog-clear-form" style="display: inline;">
                                        {{ csrfInput() }}
                                        {{ actionInput('freelog/logs/clear') }}
                                        {{ hiddenInput('file', file.name) }}
                                        <button type="submit" class="btn small secondary" title="Clear">Clear</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="freelog-empty">
            <p>No log files found.</p>
        </div>
    {% endif %}
{% endblock %}
