{% extends '_layouts/cp.twig' %}
{% import '_includes/forms' as forms %}

{% do view.registerAssetBundle('justinholtweb\\freelog\\assetbundles\\FreelogAsset') %}
{% do view.registerTranslations('freelog', [
    'Start auto-refresh',
    'Stop auto-refresh',
]) %}

{% set title = filename %}
{% set selectedSubnavItem = 'logs' %}

{% set crumbs = [
    { label: 'Freelog'|t('freelog'), url: cpUrl('freelog') }
] %}

{% set levels = {
    emergency: 'Emergency'|t('freelog'),
    alert: 'Alert'|t('freelog'),
    critical: 'Critical'|t('freelog'),
    error: 'Error'|t('freelog'),
    warning: 'Warning'|t('freelog'),
    notice: 'Notice'|t('freelog'),
    info: 'Info'|t('freelog'),
    debug: 'Debug'|t('freelog'),
} %}

{% block sidebar %}
    <nav aria-label="{{ 'Log files'|t('freelog') }}">
        <h6 class="heading">{{ 'Log files'|t('freelog') }}</h6>
        <ul class="freelog-sidebar-files">
            {% for file in files %}
                <li class="{{ file.name == filename ? 'active' }}">
                    <a href="{{ cpUrl('freelog/view', { file: file.name }) }}" {{ file.name == filename ? 'aria-current="page"' }}>
                        {{ file.name }}
                        {% if file.compressed %}<span class="freelog-badge">gz</span>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}

{% block content %}
    {# Toolbar: search, filter, actions #}
    <form method="get" action="{{ cpUrl('freelog/view') }}" id="freelog-filter">
        {{ hiddenInput('file', filename) }}
        <div class="freelog-toolbar">
            <div class="freelog-toolbar-search">
                {{ forms.text({
                    id: 'freelog-search',
                    name: 'search',
                    type: 'search',
                    value: search,
                    placeholder: 'Search log entries'|t('freelog'),
                    class: 'fullwidth',
                    inputAttributes: { aria: { label: 'Search log entries'|t('freelog') } },
                }) }}
            </div>
            {{ forms.select({
                id: 'freelog-level',
                name: 'level',
                value: level,
                options: [{ label: 'All levels'|t('freelog'), value: '' }]|merge(levels|map((label, value) => { label: label, value: value })|values),
                inputAttributes: { aria: { label: 'Level'|t('freelog') } },
            }) }}
            <button type="submit" class="btn submit">{{ 'Filter'|t('freelog') }}</button>
            <a href="{{ cpUrl('freelog/download', { file: filename }) }}" class="btn">{{ 'Download'|t('freelog') }}</a>
        </div>
    </form>

    {# Tail / live refresh section #}
    <div class="freelog-tail-controls">
        <button type="button" id="freelog-tail-toggle" class="btn small submit" aria-controls="freelog-tail-content" aria-expanded="false">{{ 'Start auto-refresh'|t('freelog') }}</button>
        <span id="freelog-tail-status" class="freelog-tail-status">
            <span class="dot"></span>
            {{ 'Auto-refresh'|t('freelog') }}
        </span>
    </div>
    <div id="freelog-tail-content" class="freelog-tail" data-file="{{ filename }}" aria-live="polite" hidden></div>

    {# Parsed entries table #}
    {% if entries|length %}
        <div class="freelog-entries">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col" class="col-date">{{ 'Date'|t('freelog') }}</th>
                        <th scope="col" class="col-level">{{ 'Level'|t('freelog') }}</th>
                        <th scope="col" class="col-category">{{ 'Category'|t('freelog') }}</th>
                        <th scope="col">{{ 'Message'|t('freelog') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        <tr data-expandable>
                            <td class="col-date">{{ entry.date }}</td>
                            <td class="col-level">
                                <span class="freelog-level freelog-level-{{ entry.level|lower }}">{{ levels[entry.level|lower] ?? entry.level }}</span>
                            </td>
                            <td class="col-category" title="{{ entry.category }}">{{ entry.category }}</td>
                            <td class="col-message">
                                <span class="message-preview">{{ entry.message|split("\n")|first }}</span>
                                <span class="message-full">{{ entry.message }}</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
            <div class="freelog-pagination">
                <span class="page-info">
                    {{ 'Showing {first}–{last} of {total} entries'|t('freelog', {
                        first: ((page - 1) * limit) + 1,
                        last: min(page * limit, total),
                        total: total,
                    }) }}
                </span>
                <div class="page-links">
                    {% if page > 1 %}
                        <a href="{{ cpUrl('freelog/view', { file: filename, search: search, level: level, page: page - 1 }) }}" class="btn small">{{ 'Previous'|t('freelog') }}</a>
                    {% endif %}
                    {% if page < totalPages %}
                        <a href="{{ cpUrl('freelog/view', { file: filename, search: search, level: level, page: page + 1 }) }}" class="btn small">{{ 'Next'|t('freelog') }}</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="freelog-empty">
            <p>
                {% if search or level %}
                    {{ 'No entries match your filters.'|t('freelog') }}
                {% else %}
                    {{ 'This log file is empty or could not be parsed.'|t('freelog') }}
                {% endif %}
            </p>
        </div>
    {% endif %}
{% endblock %}
