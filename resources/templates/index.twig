{# Freelog → the log files in storage/logs. A partial rendered inside CpScreenResponse::contentTemplate(). #}
<div class="freelog" data-freelog-confirm="{{ 'Are you sure you want to clear this log file? This cannot be undone.'|t('freelog') }}">
    {% if files|length %}
        <div class="freelog-file-list">
            <table class="data fullwidth freelog-table">
                <thead>
                    <tr>
                        <th scope="col">{{ 'File'|t('freelog') }}</th>
                        <th scope="col">{{ 'Size'|t('freelog') }}</th>
                        <th scope="col">{{ 'Last modified'|t('freelog') }}</th>
                        <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('freelog') }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for file in files %}
                        <tr>
                            <td>
                                <a class="file-name" href="{{ cpUrl('freelog/view', { file: file.name }) }}">{{ file.name }}</a>
                                {% if file.compressed %}
                                    <span class="freelog-badge" title="{{ 'Gzip-compressed; decompressed on read'|t('freelog') }}">gz</span>
                                {% endif %}
                            </td>
                            <td class="freelog-file-meta">{{ file.sizeFormatted }}</td>
                            <td class="freelog-file-meta">{{ file.modifiedFormatted }}</td>
                            <td class="freelog-file-actions">
                                <div class="freelog-actions">
                                    <a href="{{ cpUrl('freelog/view', { file: file.name }) }}" class="btn small">{{ 'View'|t('freelog') }}</a>
                                    <a href="{{ cpUrl('freelog/download', { file: file.name }) }}" class="btn small" download>{{ 'Download'|t('freelog') }}</a>
                                    {% if canClear %}
                                        <form method="post" action="{{ cpUrl('freelog/clear') }}" class="freelog-clear-form">
                                            {{ csrf_field() }}
                                            <input type="hidden" name="file" value="{{ file.name }}">
                                            <button type="submit" class="btn small">{{ 'Clear'|t('freelog') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="freelog-empty">
            <p>{{ 'No log files found.'|t('freelog') }}</p>
        </div>
    {% endif %}
</div>
